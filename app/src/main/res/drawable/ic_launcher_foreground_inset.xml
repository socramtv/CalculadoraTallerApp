<?xml version="1.0" encoding="utf-8"?>
<!--
    El icono adaptativo (Android 8+) dibuja el primer plano en un lienzo de
    108dp x 108dp, pero cada fabricante le aplica su propia máscara
    (círculo, superelipse, esquinas redondeadas...) que solo garantiza
    visible la "zona segura" central de 72dp x 72dp; lo que quede fuera de
    ahí se recorta -y varía según el lanzador-. Como ic_launcher_app.png
    (el logo real de la app, tal cual está en el repo) llena el lienzo
    entero de borde a borde, se vería recortado ("con zoom") sin este
    margen. Este inset de 18dp por lado (108-72=36, mitad a cada lado) mete
    el PNG dentro de esa zona segura sin tocar el archivo original.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_app"
    android:insetLeft="18dp"
    android:insetTop="18dp"
    android:insetRight="18dp"
    android:insetBottom="18dp" />
